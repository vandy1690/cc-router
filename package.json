{
  "name": "cc-router",
  "version": "1.1.0",
  "description": "Claude Code Router: routes a prompt to the right Claude model. A macOS desktop app that runs Claude Code sessions with live plan usage and session recall, plus a Claude Code plugin that shares the same routing rules.",
  "main": "main.js",
  "scripts": {
    "route": "node src/cli.js",
    "route:test": "node src/cli.js --selftest",
    "check": "node scripts/check.mjs",
    "projects": "node src/projects-cli.js",
    "usage": "node src/usage-cli.js",
    "start": "electron .",
    "app": "node scripts/make-app.mjs",
    "app:remove": "node scripts/make-app.mjs --remove",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "keywords": [],
  "author": "Steven Design Services LLC",
  "license": "UNLICENSED",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@electron/rebuild": "^4.1.0",
    "electron": "^43.0.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.12"
  }
}

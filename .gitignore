# Dependencies (large; node-pty is a native build, rebuild locally)
node_modules/

# Build output. build/ holds packaging output too, but the Dock icon lives
# there and is source art, so those two files are tracked.
dist/
build/*
!build/icon.png
!build/icon.icns
out/

# OS / editor
.DS_Store
*.log

# Local runtime state (usage sync anchors live in ~/.cc-router, not the repo)
.cc-router/

# Patch files handed around by hand; they do not belong in the history.
*.patch
